# ============================================================
# Kalshi Trading Bot — Fill in your 3 values below
# ============================================================

# 1. YOUR KALSHI API KEY
#    Go to: https://kalshi.com
#    Log in → click your profile → Settings → API → "Create Key"
#    Copy the key and paste it below (replace the placeholder)
KALSHI_API_KEY=PASTE_YOUR_KALSHI_API_KEY_HERE

# 2. YOUR TELEGRAM BOT TOKEN
#    Open Telegram → search @BotFather → send /newbot
#    Follow the steps, give your bot a name
#    BotFather will reply with a token that looks like: 7123456789:AAFxxxxxxxx
#    Copy it and paste it below
TELEGRAM_BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE

# 3. YOUR TELEGRAM CHAT ID
#    Open Telegram → search @userinfobot → send /start
#    It will reply with a number like: Id: 987654321
#    Copy that number and paste it below
TELEGRAM_CHAT_ID=PASTE_YOUR_CHAT_ID_NUMBER_HERE

# ============================================================
# Everything below this line is already set — do not change
# ============================================================
SCAN_INTERVAL_SEC=30
DB_PATH=trades.db
LOG_FILE=bot.log
