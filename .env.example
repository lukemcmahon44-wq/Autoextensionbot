# ============================================================
# Kalshi Trading Bot — Environment Variables Template
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Kalshi API
# ----------------------------------------------------------
# Your Kalshi API key (found in Settings → API on kalshi.com)
KALSHI_API_KEY=your_kalshi_api_key_here

# ----------------------------------------------------------
# Telegram Alerts
# ----------------------------------------------------------
# Create a bot via @BotFather on Telegram to get a token
TELEGRAM_BOT_TOKEN=123456789:ABCdef_your_telegram_bot_token_here

# Your Telegram chat ID (use @userinfobot or getUpdates to find it)
TELEGRAM_CHAT_ID=your_chat_id_here

# ----------------------------------------------------------
# Bot Behaviour (optional — defaults shown)
# ----------------------------------------------------------
# Seconds between full market scans
SCAN_INTERVAL_SEC=30

# Path to SQLite database file
DB_PATH=trades.db

# Path to log file
LOG_FILE=bot.log
