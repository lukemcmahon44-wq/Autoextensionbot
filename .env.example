# Copy to .env and fill in. NEVER commit .env or your private key.
#
# Kalshi API key ID (the UUID shown when you create an API key in the Kalshi UI).
KALSHI_API_KEY_ID=

# Path to the RSA private key file you downloaded when creating the API key.
# Keep this file out of the repo (it is .gitignored as *.pem). The key is never logged.
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Optional: webhook (Slack/Discord/generic) for trade + halt + daily-summary alerts.
ALERT_WEBHOOK_URL=

# Dry-run override. When true, the bot ALWAYS runs in paper mode regardless of
# config.yaml -> mode.paper_trading, and never touches a real-money endpoint.
# Recommended for all development and testing. Unset / "false" => obey config.yaml
# (which ships as LIVE by default).
FORCE_PAPER=true
