# ===========================================================================
# Copy to .env and fill in. NEVER commit .env. See README for how to obtain
# each key. config.py loads these; behavior knobs live in config.yaml.
# ===========================================================================

# ---------- Anthropic (Claude) ----------
ANTHROPIC_API_KEY=

# ---------- Retell AI ----------
RETELL_API_KEY=
RETELL_AGENT_ID=                 # llm_mode=retell_managed: the agent that drives calls
RETELL_LLM_WEBSOCKET_URL=        # llm_mode=custom_claude: wss://<your-host>/llm-websocket

# ---------- Twilio ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=              # E.164, e.g. +14155551234 (your outbound caller ID)

# ---------- ElevenLabs ----------
ELEVENLABS_API_KEY=
# voice_id is set in config.yaml

# ---------- Google Calendar (OAuth user flow is primary) ----------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=      # obtained via the consent flow (see README)
# Optional alternative to OAuth (e.g. Workspace domain-wide delegation):
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=primary

# ---------- Server / webhooks ----------
PUBLIC_BASE_URL=                 # public https base for Retell webhooks (e.g. ngrok)
WEBHOOK_SECRET=                  # shared secret / signature verification (optional)
DATABASE_URL=sqlite:///voiceagent.db   # postgresql+psycopg://user:pass@host/db for PG

# ---------- App ----------
LOG_LEVEL=INFO
ENV=dev
